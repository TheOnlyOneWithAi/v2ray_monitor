APP_NAME=V2Ray Monitor
BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to administer the bot.
ADMIN_IDS=
WEBAPP_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite+aiosqlite:///./data/monitor.db
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
XRAY_BINARY=/usr/local/bin/xray
PROBE_TIMEOUT=8
PROBE_INTERVAL=60
PROBE_CONCURRENCY=10
SYNC_INTERVAL=300
MAX_SUBSCRIPTION_BYTES=5000000
MAX_NODES_PER_SUBSCRIPTION=2000
